rules_version = '2';

// El servidor Flask usa el Admin SDK (ignora estas reglas). Estas reglas solo
// aplican a accesos directos desde el navegador: cada usuario únicamente puede
// leer/escribir sus propios documentos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
