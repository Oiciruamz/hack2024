# Copia este archivo a .env y completa tus claves.

# --- Mistral OCR ---
# Docs OCR: https://docs.mistral.ai/capabilities/document_ai/basic_ocr
# Modelo usado: mistral-ocr-latest
MISTRAL_API_KEY=

# --- Flask ---
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Google Books ---
GOOGLE_BOOKS_API_KEY=

# --- Firebase (servidor / Admin SDK) ---
# Consola Firebase → Configuración del proyecto → Cuentas de servicio → Generar clave privada.
# Ruta relativa a la raíz del proyecto (NO subir este archivo a git).
FIREBASE_CREDENTIALS=firebase-service-account.json

# --- Firebase (navegador / JS SDK) ---
# Consola Firebase → Configuración del proyecto → Tus apps → App web → firebaseConfig.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
